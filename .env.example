# SQL Server connection used by the ETL loader and the validator.
# Copy this file to .env and set real values. Never commit .env.
# The file is read by python-dotenv and can also be loaded into a shell with
# `set -a; source .env; set +a`; quote values that contain spaces or shell
# special characters.
SQL_SERVER=localhost,1433
SQL_DATABASE=ReginaParcelExplorer
SQL_USER=your_sql_login
SQL_PASSWORD=change_me

# "yes" accepts a self-signed server certificate (local development only).
SQL_TRUST_SERVER_CERTIFICATE=yes
